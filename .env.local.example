APP_ENV=development
DATABASE_URL=sqlite:///./asr_viz.db
AUTO_CREATE_SCHEMA=true
AUTH_PROVIDER=disabled
REQUIRE_AUTH=false
AUTH_DEV_USER_ID=local-dev-user
ANONYMOUS_SESSION_COOKIE_NAME=asr_viz_anon_session
ANONYMOUS_SESSION_COOKIE_MAX_AGE_SECONDS=15552000
ANONYMOUS_SESSION_COOKIE_SECURE=false
ANONYMOUS_SESSION_COOKIE_DOMAIN=
CLERK_ISSUER_URL=
CLERK_AUDIENCE=
CLERK_JWKS_URL=
CORS_ORIGINS=http://localhost:4173,http://127.0.0.1:4173
ENABLE_MOCK_TRANSCRIPTION=false
ASR_MODEL=small
ENABLE_DIARIZATION=true
DIARIZATION_MIN_SPEAKERS=1
DIARIZATION_MAX_SPEAKERS=3
MAX_UPLOAD_SIZE_BYTES=104857600
PER_USER_STORAGE_QUOTA_BYTES=524288000
LIVE_MODE_ENABLED=false
STORAGE_BACKEND=local
MEDIA_STORAGE_DIR=./.media
SIGNED_URL_TTL_SECONDS=900
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
WORKER_NAME=render-cpu-worker

# needed for speaker diarization 
HUGGINGFACE_TOKEN=
